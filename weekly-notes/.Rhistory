)
# Spatial join tracts to counties
pa_counties_proj <- st_transform(pa_counties, 26918)
vuln_with_county <- st_join(
vulnerable_tracts_proj,
pa_counties_proj %>% dplyr::select(county_geoid = GEOID, county_name = NAME),
join = st_within, left = TRUE
)
View(pa_counties)
# Spatial join tracts to counties
pa_counties_proj <- st_transform(pa_counties, 26918)
vuln_with_county <- st_join(
vulnerable_tracts_proj,
pa_counties_proj %>% dplyr::select(county_geoid = FIPS_COUNT, county_name = COUNTY_NAM),
join = st_within, left = TRUE
)
# Aggregate statistics by county
county_stats <- vuln_with_county %>%
st_drop_geometry() %>%
group_by(county_gepid, county_name) %>%
summarise(
num_vulnerable = dyler::n(),
num_vulnerable = sum(underserved, na.rm = TRUE),
pct_underserved = 100 * num_underserved / num_vulnerable,
avg_dist_miles  = mean(dist_to_nearest_hospital_miles, na.rm = TRUE),
total_vulnerable_pop = NA_real_
) %>%
top5_pct_underserved <- county_stats %>% slice_max(pct_underserved, n = 5)
