# Load spatial data
pa_counties <- st_read("D:/Code/MUSA-5080-Fall-2025/labs/lab_2/data/Pennsylvania_County_Boundaries.shp")
pa_hospitals <- st_read("D:/Code/MUSA-5080-Fall-2025/labs/lab_2/data/hospitals.geojson")
pa_tracts <- st_read("D:/Code/MUSA-5080-Fall-2025/labs/lab_2/data/districts.geojson")
# Check that all data loaded correctly
class(pa_counties)
nrow(pa_hospitals)
nrow(pa_tracts)
st_crs(pa_counties)
st_crs(pa_hospitals)
st_crs(pa_tracts)
# Get demographic data from ACS
vars <- c(
total_pop = "B01003_001",
med_income = "B19013_001"
)
age_vars <- c(
"B01001_020", "B01001_021", "B01001_022", "B01001_023", "B01001_024", "B01001_025",  # Males 65+
"B01001_044", "B01001_045", "B01001_046", "B01001_047", "B01001_048", "B01001_049"   # Females 65+
)
pa_demo <- get_acs(
geography = "tract",
variables = vars,
state = "PA",
year = 2022,
geometry = TRUE
)
pa_age <- get_acs(
geography = "tract",
variables = age_vars,
state = "PA",
year = 2022
)
# Join to tract boundaries
pa_age65plus <- pa_age %>%
group_by(GEOID) %>%
summarise(age65plus = sum(estimate, na.rm = TRUE))
pa_demo_wide <- pa_demo %>%
select(GEOID, variable, estimate) %>%
tidyr::pivot_wider(names_from = variable, values_from = estimate)
pa_demo_final <- pa_demo_wide %>%
left_join(pa_age65plus, by = "GEOID")
pa_income <- pa_demo %>%
dplyr::filter(variable == "med_income") %>%
dplyr::select(GEOID, NAME, estimate)
nrow(pa_income)
sum(is.na(pa_income$estimate))
median(pa_income$estimate, na.rm = TRUE)
# Filter for vulnerable tracts based on your criteria
median_income_pa <- median(pa_income$estimate, na.rm = TRUE)
income_threshold <- median_income_pa * 0.8
elderly_threshold <- 0.15
pa_demo_final <- pa_demo_final %>%
mutate(elderly_share = age65plus / total_pop)
vulnerable_tracts <- pa_demo_final %>%
filter(
med_income < income_threshold,
elderly_share > elderly_threshold
)
n_vulnerable <- nrow(vulnerable_tracts)
pct_vulnerable <- n_vulnerable / nrow(pa_demo_final) * 100
n_vulnerable
pct_vulnerable
# Transform to appropriate projected CRS
pa_hospitals <- st_read("D:/Code/MUSA-5080-Fall-2025/labs/lab_2/data/hospitals.geojson")
vulnerable_tracts_proj <- st_transform(vulnerable_tracts, 26918)
pa_hospitals_proj <- st_transform(pa_hospitals, 26918)
# Calculate distance from each tract centroid to nearest hospital
tract_centroids <- st_centroid(vulnerable_tracts_proj)
dist_matrix <- st_distance(tract_centroids, pa_hospitals_proj)
nearest_dist <- apply(dist_matrix, 1, min)
vulnerable_tracts_proj <- vulnerable_tracts_proj %>%
mutate(dist_to_nearest_hospital_m = as.numeric(nearest_dist),
dist_to_nearest_hospital_km = dist_to_nearest_hospital_m / 1000)
summary(vulnerable_tracts_proj$dist_to_nearest_hospital_km)
