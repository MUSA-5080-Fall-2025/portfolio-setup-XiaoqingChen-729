st_drop_geometry() %>%
dplyr::group_by(county_geoid, county_name) %>%
dplyr::summarise(
num_vulnerable  = dplyr::n(),
num_underserved = sum(underserved, na.rm = TRUE),
pct_underserved = dplyr::if_else(
num_vulnerable > 0,
100 * num_underserved / num_vulnerable,
NA_real_
),
avg_dist_miles  = mean(dist_to_nearest_hospital_miles, na.rm = TRUE)
) %>%
dplyr::arrange(dplyr::desc(pct_underserved))
top5_pct_underserved <- county_stats %>% dplyr::slice_max(pct_underserved, n = 5)
nrow(top5_pct_underserved)
View(top5_pct_underserved)
