# Load required packages
library(sf)
library(tigris)
library(tidycensus)
library(dplyr)
library(knitr)
census_api_key(Sys.getenv("e17c1c6ce413dc3faca31a17a58ab3374404bb9e"), install = FALSE)
# Load spatial data
pa_counties <- st_read("data/Pennsylvania_County_Boundaries.shp")
pa_hospitals <- st_read("data/hospitals.geojson")
pa_tracts <- st_read("data/districts.geojson")
# Check that all data loaded correctly
class(pa_counties)
nrow(pa_hospitals)
nrow(pa_tracts)
st_crs(pa_counties)
st_crs(pa_hospitals)
st_crs(pa_tracts)
# Get demographic data from ACS
vars <- c(
total_pop = "B01003_001",
med_income = "B19013_001"
)
age_vars <- c(
"B01001_020", "B01001_021", "B01001_022", "B01001_023", "B01001_024", "B01001_025",  # Males 65+
"B01001_044", "B01001_045", "B01001_046", "B01001_047", "B01001_048", "B01001_049"   # Females 65+
)
pa_demo <- get_acs(
geography = "tract",
variables = vars,
state = "PA",
year = 2022,
geometry = TRUE
)
pa_age <- get_acs(
geography = "tract",
variables = age_vars,
state = "PA",
year = 2022
)
# Join to tract boundaries
pa_age65plus <- pa_age %>%
group_by(GEOID) %>%
summarise(age65plus = sum(estimate, na.rm = TRUE))
pa_demo_wide <- pa_demo %>%
select(GEOID, variable, estimate) %>%
tidyr::pivot_wider(names_from = variable, values_from = estimate)
pa_demo_final <- pa_demo_wide %>%
left_join(pa_age65plus, by = "GEOID")
pa_income <- pa_demo %>%
dplyr::filter(variable == "med_income") %>%
dplyr::select(GEOID, NAME, estimate)
nrow(pa_income)
sum(is.na(pa_income$estimate))
median(pa_income$estimate, na.rm = TRUE)
# Filter for vulnerable tracts based on your criteria
median_income_pa <- median(pa_income$estimate, na.rm = TRUE)
income_threshold <- median_income_pa * 0.8
elderly_threshold <- 0.15
pa_demo_final <- pa_demo_final %>%
mutate(elderly_share = age65plus / total_pop)
vulnerable_tracts <- pa_demo_final %>%
filter(
med_income < income_threshold,
elderly_share > elderly_threshold
)
n_vulnerable <- nrow(vulnerable_tracts)
pct_vulnerable <- n_vulnerable / nrow(pa_demo_final) * 100
n_vulnerable
pct_vulnerable
# Transform to appropriate projected CRS
pa_hospitals <- st_read("D:/Code/MUSA-5080-Fall-2025/labs/lab_2/data/hospitals.geojson")
vulnerable_tracts_proj <- st_transform(vulnerable_tracts, 26918)
pa_hospitals_proj <- st_transform(pa_hospitals, 26918)
# Calculate distance from each tract centroid to nearest hospital
tract_centroids <- st_centroid(vulnerable_tracts_proj)
dist_matrix <- st_distance(tract_centroids, pa_hospitals_proj)
nearest_dist <- apply(dist_matrix, 1, min)
vulnerable_tracts_proj <- vulnerable_tracts_proj %>%
mutate(dist_to_nearest_hospital_m = as.numeric(nearest_dist),
dist_to_nearest_hospital_miles = dist_to_nearest_hospital_m / 1609.34)
summary(vulnerable_tracts_proj$dist_to_nearest_hospital_miles)
sum(vulnerable_tracts_proj$dist_to_nearest_hospital_miles > 15)
# Transform to appropriate projected CRS
pa_hospitals <- st_read("data/hospitals.geojson")
vulnerable_tracts_proj <- st_transform(vulnerable_tracts, 26918)
pa_hospitals_proj <- st_transform(pa_hospitals, 26918)
# Calculate distance from each tract centroid to nearest hospital
tract_centroids <- st_centroid(vulnerable_tracts_proj)
dist_matrix <- st_distance(tract_centroids, pa_hospitals_proj)
nearest_dist <- apply(dist_matrix, 1, min)
vulnerable_tracts_proj <- vulnerable_tracts_proj %>%
mutate(dist_to_nearest_hospital_m = as.numeric(nearest_dist),
dist_to_nearest_hospital_miles = dist_to_nearest_hospital_m / 1609.34)
summary(vulnerable_tracts_proj$dist_to_nearest_hospital_miles)
sum(vulnerable_tracts_proj$dist_to_nearest_hospital_miles > 15)
# Create underserved variable
vulnerable_tracts_proj <- vulnerable_tracts_proj %>%
mutate(
underserved = dist_to_nearest_hospital_miles > 15
)
num_underserved <- sum(vulnerable_tracts_proj$underserved, na.rm = TRUE)
pct_underserved <- num_underserved / nrow(vulnerable_tracts_proj) * 100
list(
underserved_tracts = num_underserved,
percent_underserved = round(pct_underserved, 2)
)
# Spatial join tracts to counties
counties_index <- pa_counties_proj %>%
st_drop_geometry() %>%
distinct(county_geoid = FIPS_COUNT, county_name = COUNTY_NAM)
# Spatial join tracts to counties
pa_counties <- st_read("data/Pennsylvania_County_Boundaries.shp")
pa_counties_proj <- st_transform(pa_counties, 26918)
counties_index <- pa_counties_proj %>%
st_drop_geometry() %>%
distinct(county_geoid = FIPS_COUNT, county_name = COUNTY_NAM)
county_stats <- vuln_with_county %>%
st_drop_geometry() %>%
group_by(county_geoid, county_name) %>%
summarise(
num_vulnerable  = n(),
num_underserved = sum(underserved, na.rm = TRUE),
avg_dist_miles  = mean(dist_to_nearest_hospital_miles, na.rm = TRUE)
)
# Spatial join tracts to counties
pa_counties <- st_read("data/Pennsylvania_County_Boundaries.shp")
pa_counties_proj <- st_transform(pa_counties, 26918)
counties_index <- pa_counties_proj %>%
st_drop_geometry() %>%
distinct(county_geoid = FIPS_COUNT, county_name = COUNTY_NAM)
vuln_with_county <- sf::st_join(
vulnerable_tracts_proj,
pa_counties_proj %>% dplyr::select(
county_geoid = FIPS_COUNT, county_name = COUNTY_NAM
),
join = sf::st_within, left = TRUE
)
county_stats <- vuln_with_county %>%
st_drop_geometry() %>%
group_by(county_geoid, county_name) %>%
summarise(
num_vulnerable  = n(),
num_underserved = sum(underserved, na.rm = TRUE),
avg_dist_miles  = mean(dist_to_nearest_hospital_miles, na.rm = TRUE)
)
library(tidyr)
# Aggregate statistics by county
county_stats_all <- counties_index %>%
left_join(county_stats, by = c("county_geoid","county_name")) %>%
mutate(
num_vulnerable   = replace_na(num_vulnerable, 0L),
num_underserved  = replace_na(num_underserved, 0L),
pct_underserved  = if_else(num_vulnerable > 0,
100 * num_underserved / num_vulnerable,
0),
avg_dist_miles   = if_else(num_vulnerable > 0, avg_dist_miles, NA_real_)
)
top5_by_pct <- county_stats_all %>%
filter(num_vulnerable > 0) %>%
slice_max(pct_underserved, n = 5)
top5_by_count <- county_stats_all %>%
slice_max(num_underserved, n = 5)
top5_by_pct
top5_by_count
# Create and format priority counties table
library(knitr)
library(scales)
priority_counties <- county_stats_all %>%
arrange(desc(pct_underserved)) %>%
slice_head(n = 10) %>%
mutate(
pct_underserved = percent(pct_underserved / 100, accuracy = 0.1),
avg_dist_miles  = round(avg_dist_miles, 1)
) %>%
select(
"County Name" = county_name,
"Vulnerable Tracts" = num_vulnerable,
"Underserved Tracts" = num_underserved,
"Percent Underserved" = pct_underserved,
"Avg. Distance to Hospital (miles)" = avg_dist_miles
)
kable(priority_counties,
caption = "Top 10 Pennsylvania Counties Prioritized for Healthcare Investment",
align = "lrrrr",
format = "markdown")
# Create county-level access map
library(ggplot2)
library(sf)
library(viridis)
county_map <- pa_counties_proj %>%
left_join(county_stats_all, by = c("FIPS_COUNT" = "county_geoid", "COUNTY_NAM" = "county_name"))
grey_blue <- c(
"#F4F6F6",
"#D8E0E5",
"#B9C9D2",
"#9AAEBF",
"#7F97A6",
"#5E7C8A",
"#405E70",
"#2E4757"
)
ggplot() +
geom_sf(data = county_map, aes(fill = pct_underserved), color = "white", size = 0.2) +
geom_sf(data = pa_hospitals_proj, color = "grey30", size = 0.8, alpha = 0.5) +
scale_fill_gradientn(
colours = soft_palette,
name = "% Underserved",
limits = c(0, 100),
labels = scales::percent_format(scale = 1),
na.value = "grey95"
) +
theme_void() +
theme(
legend.position = "right",
plot.title = element_text(size = 14, face = "bold", color = "grey20", hjust = 0.5),
plot.subtitle = element_text(size = 11, color = "grey40", hjust = 0.5),
plot.caption = element_text(size = 9, color = "grey50", hjust = 0.5),
panel.background = element_rect(fill = "white", color = NA)
) +
labs(
title = "Healthcare Access Across Pennsylvania Counties",
subtitle = "Percentage of vulnerable tracts more than 15 miles from nearest hospital",
caption = "Data: ACS 2022, hospitals.geojson"
)
# Create county-level access map
library(ggplot2)
library(sf)
library(viridis)
county_map <- pa_counties_proj %>%
left_join(county_stats_all, by = c("FIPS_COUNT" = "county_geoid", "COUNTY_NAM" = "county_name"))
grey_blue <- c(
"#F4F6F6",
"#D8E0E5",
"#B9C9D2",
"#9AAEBF",
"#7F97A6",
"#5E7C8A",
"#405E70",
"#2E4757"
)
ggplot() +
geom_sf(data = county_map, aes(fill = pct_underserved), color = "white", size = 0.2) +
