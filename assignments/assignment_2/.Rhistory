labels = scales::percent_format(scale = 1),
na.value = "grey95"
) +
theme_void() +
theme(
legend.position = "right",
plot.title = element_text(size = 14, face = "bold", color = "grey20", hjust = 0.5),
plot.subtitle = element_text(size = 11, color = "grey40", hjust = 0.5),
plot.caption = element_text(size = 9, color = "grey50", hjust = 0.5),
panel.background = element_rect(fill = "white", color = NA)
) +
labs(
title = "Healthcare Access Across Pennsylvania Counties",
subtitle = "Percentage of vulnerable tracts more than 15 miles from nearest hospital",
caption = "Data: ACS 2022, hospitals.geojson"
)
# Create detailed tract-level map
tract_palette <- c(
"FALSE" = "#B7C4CF",
"TRUE"  = "#8B3A3A"
)
ggplot() +
geom_sf(data = pa_counties_proj, fill = "white", color = "grey85", size = 0.2) +
geom_sf(data = vulnerable_tracts_proj,
aes(fill = as.factor(underserved)),
color = NA, alpha = 0.8) +
geom_sf(data = pa_hospitals_proj, color = "grey30", size = 0.7, alpha = 0.5) +
scale_fill_manual(
values = tract_palette,
name = "Underserved Status",
labels = c("Not Underserved", "Underserved")
) +
theme_void() +
theme(
legend.position = "right",
plot.title = element_text(size = 14, face = "bold", color = "#333333", hjust = 0.5),
plot.subtitle = element_text(size = 11, color = "grey40", hjust = 0.5),
plot.caption = element_text(size = 9, color = "grey50", hjust = 0.5),
legend.title = element_text(size = 10, face = "bold"),
legend.text = element_text(size = 9)
) +
labs(
title = "Underserved Vulnerable Census Tracts in Pennsylvania",
subtitle = "Tracts more than 15 miles from nearest hospital (highlighted in warm red-brown)",
caption = "Data: ACS 2022, hospitals.geojson"
)
# Create distribution visualization
ggplot(vulnerable_tracts_proj, aes(x = dist_to_nearest_hospital_miles)) +
geom_histogram(
fill = "#8B3A3A",
color = "white",
bins = 30,
alpha = 0.8
) +
geom_vline(aes(xintercept = 15), color = "#405E70", linetype = "dashed", size = 0.8) +
theme_minimal() +
labs(
title = "Distribution of Distance to Nearest Hospital",
subtitle = "Vulnerable census tracts across Pennsylvania",
x = "Distance to nearest hospital (miles)",
y = "Number of tracts",
caption = "Dashed line represents 15-mile threshold for underserved classification"
) +
theme(
plot.title = element_text(face = "bold", size = 14, color = "#2E4757", hjust = 0.5),
plot.subtitle = element_text(size = 11, color = "grey40", hjust = 0.5),
axis.title = element_text(size = 10, hjust = 0.5),
panel.grid.minor = element_blank()
)
# Load your additional dataset
library(sf)
library(dplyr)
library(tidycensus)
library(tigris)
bike_stations <- st_read("indego_stations.geojson")
glimpse(bike_stations)
st_crs(bike_stations)
nrow(bike_stations)
philly_tracts <- tracts(state = "PA", county = "Philadelphia", year = 2022, cb = TRUE)
st_crs(philly_tracts)
bike_stations <- st_transform(bike_stations, st_crs(philly_tracts))
plot(st_geometry(philly_tracts))
plot(st_geometry(bike_stations), add = TRUE, col = "blue", pch = 16, cex = 0.5)
bike_stations <- st_transform(bike_stations, 26918)
philly_tracts <- st_transform(philly_tracts, 26918)
# Your spatial analysis
tract_bikes <- st_join(philly_tracts, bike_stations) %>%
group_by(GEOID) %>%
summarise(
num_stations = n()
)
tract_centroids <- st_centroid(philly_tracts)
dist_matrix <- st_distance(tract_centroids, bike_stations)
tract_centroids$nearest_station_dist_m <- apply(dist_matrix, 1, min)
tract_centroids <- tract_centroids %>%
mutate(nearest_station_dist_miles = as.numeric(nearest_station_dist_m) / 1609.34)
philly_tracts <- philly_tracts %>%
left_join(st_drop_geometry(tract_centroids)[, c("GEOID", "nearest_station_dist_miles")], by = "GEOID")
summary(philly_tracts$nearest_station_dist_miles)
phl_income <- get_acs(
geography = "tract",
variables = "B19013_001",
state = "PA",
county = "Philadelphia",
year = 2022,
geometry = FALSE,
cache_table = TRUE
) %>%
select(GEOID, med_hh_inc = estimate)
philly_tracts <- philly_tracts %>%
left_join(phl_income, by = "GEOID")
city_median_income <- median(philly_tracts$med_hh_inc, na.rm = TRUE)
low_income_threshold <- 0.8 * city_median_income
philly_tracts <- philly_tracts %>%
mutate(
low_income = med_hh_inc < low_income_threshold
)
access_by_income <- philly_tracts %>%
group_by(low_income) %>%
summarise(
tracts = n(),
mean_distance = mean(nearest_station_dist_miles, na.rm = TRUE),
median_distance = median(nearest_station_dist_miles, na.rm = TRUE)
)
access_by_income
ggplot(philly_tracts, aes(x = low_income, y = nearest_station_dist_miles, fill = low_income)) +
geom_boxplot(alpha = 0.7) +
scale_fill_manual(values = c("FALSE" = "#405E70", "TRUE" = "#8B3A3A")) +
scale_x_discrete(labels = c("FALSE" = "Non-low-income", "TRUE" = "Low-income")) +
labs(
x = NULL,
y = "Distance to nearest Indego station (miles)",
title = "Bike-share Accessibility by Income Group",
subtitle = "Low-income tracts are generally farther from bike share stations"
) +
theme_minimal() +
theme(
legend.position = "none",
plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5)
)
