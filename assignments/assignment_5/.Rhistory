library(lubridate)
library(sf)
library(dplyr)
## 1) Holiday indicator: major Q4 holidays
study_panel_complete <- study_panel_complete %>%
mutate(
date = as.Date(interval60),
is_holiday = ifelse(
date %in% as.Date(c(
"2024-10-31", # Halloween
"2024-11-28", # Thanksgiving
"2024-11-29", # Black Friday
"2024-12-24", # Christmas Eve
"2024-12-25", # Christmas Day
"2024-12-31"  # New Year's Eve
)),
1, 0
)
)
## 2) Weekend × good weather interaction
# Define Q4 good weather
study_panel_complete <- study_panel_complete %>%
mutate(
good_weather = ifelse(
Temperature >= 50 & Temperature <= 70 & Precipitation == 0,
1, 0
),
weekend_good_weather = weekend * good_weather
)
## 3) Distance to Center City (City Hall) in km
study_panel_complete <- study_panel_complete %>%
mutate(
start_lat_all = coalesce(start_lat.x, start_lat.y),
start_lon_all = coalesce(start_lon.x, start_lon.y)
)
# transfer sf
stations_sf <- study_panel_complete %>%
filter(!is.na(start_lat_all), !is.na(start_lon_all)) %>%
distinct(start_station, start_lat_all, start_lon_all) %>%
st_as_sf(coords = c("start_lon_all", "start_lat_all"), crs = 4326) %>%
st_transform(26918)
# locate Center City
center_city <- st_sfc(
st_point(c(-75.1636, 39.9526)),  # lon, lat of City Hall
crs = 4326
) %>%
st_transform(26918)
# Calculate each station's distance to Center City
stations_sf$dist_center_km <- as.numeric(st_distance(stations_sf, center_city)) / 1000
stations_dist <- stations_sf %>%
st_drop_geometry() %>%
select(start_station, dist_center_km)
# Join distance into panel
study_panel_complete <- study_panel_complete %>%
left_join(stations_dist, by = "start_station")
## Quick check: new features
study_panel_complete %>%
select(date, hour, weekend,
Temperature, Precipitation,
is_holiday, good_weather, weekend_good_weather,
dist_center_km) %>%
head()
early_stations <- study_panel_complete %>%
filter(week < 50, Trip_Count > 0) %>%
distinct(start_station) %>%
pull(start_station)
late_stations <- study_panel_complete %>%
filter(week >= 50, Trip_Count > 0) %>%
distinct(start_station) %>%
pull(start_station)
common_stations <- intersect(early_stations, late_stations)
train_6 <- study_panel_complete %>%
filter(week < 50,
start_station %in% common_stations)
test_6 <- study_panel_complete %>%
filter(week >= 50,
start_station %in% common_stations)
head(test_6 %>%
select(Trip_Count, hour, weekend,
Temperature, Precipitation,
lag1Hour, lag3Hours, lag1day,
is_holiday, weekend_good_weather, dist_center_km))
cat("Model 6 R-squared:", summary(model6)$r.squared, "\n")
early_stations <- study_panel_complete %>%
filter(week < 50, Trip_Count > 0) %>%
distinct(start_station) %>%
pull(start_station)
late_stations <- study_panel_complete %>%
filter(week >= 50, Trip_Count > 0) %>%
distinct(start_station) %>%
pull(start_station)
common_stations <- intersect(early_stations, late_stations)
train_6 <- study_panel_complete %>%
filter(week < 50,
start_station %in% common_stations)
test_6 <- study_panel_complete %>%
filter(week >= 50,
start_station %in% common_stations)
head(test_6 %>%
select(Trip_Count, hour, weekend,
Temperature, Precipitation,
lag1Hour, lag3Hours, lag1day,
is_holiday, weekend_good_weather, dist_center_km))
cat("Model6 R-squared:", summary(model6)$r.squared, "\n")
early_stations <- study_panel_complete %>%
filter(week < 50, Trip_Count > 0) %>%
distinct(start_station) %>%
pull(start_station)
late_stations <- study_panel_complete %>%
filter(week >= 50, Trip_Count > 0) %>%
distinct(start_station) %>%
pull(start_station)
common_stations <- intersect(early_stations, late_stations)
train_6 <- study_panel_complete %>%
filter(week < 50,
start_station %in% common_stations)
test_6 <- study_panel_complete %>%
filter(week >= 50,
start_station %in% common_stations)
head(test_6 %>%
select(Trip_Count, hour, weekend,
Temperature, Precipitation,
lag1Hour, lag3Hours, lag1day,
is_holiday, weekend_good_weather, dist_center_km))
# Compared model 2 & 6
model2 <- lm(
Trip_Count ~ as.factor(hour) + as.factor(weekend) +
Temperature + Precipitation +
lag1Hour + lag3Hours + lag1day,
data = train
)
summary(model2)
# Model 6: Model 2 + 3 new features
model6 <- lm(
Trip_Count ~ as.factor(hour) + as.factor(weekend) +
Temperature + Precipitation +
lag1Hour + lag3Hours + lag1day +
is_holiday + weekend_good_weather + dist_center_km,
data = train_6
)
cat("Model6 R-squared:", summary(model6)$r.squared, "\n")
cat("Model6 Adj R-squared:", summary(model6)$adj.r.squared, "\n")
summary(model6)
test_6 <- test_6 %>%
mutate(
pred2 = predict(model2, newdata = test_6),  # baseline
pred6 = predict(model6, newdata = test_6)   # new features
)
mae2 <- mean(abs(test_6$Trip_Count - test_6$pred2), na.rm = TRUE)
mae6 <- mean(abs(test_6$Trip_Count - test_6$pred6), na.rm = TRUE)
mae_results_p3 <- data.frame(
Model = c("Model 2: baseline with lags",
"Model 6: + holidays + weekend weather + distance"),
MAE   = c(mae2, mae6)
)
mae_results_p3
